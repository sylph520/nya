{
    "version": "5.8.2",
    "description": "Portable global search and productivity launcher for Windows",
    "homepage": "https://github.com/Lertaro/Lertaro",
    "license": "MIT",
    "depends": "windowsdesktop-runtime",
    "extract_dir": "Lertaro",
    "persist": "Data",
    "pre_install": [
        "$launcher = @'
@echo off
setlocal
set \"DOTNET_ROOT=%ProgramFiles%\\dotnet\"
cd /d \"%~dp0\"
start \"\" \"Lertaro.App.exe\" %*
'@",
        "Set-Content -LiteralPath \"$dir\\lertaro.cmd\" -Value $launcher -Encoding Ascii"
    ],
    "shortcuts": [
        [
            "lertaro.cmd",
            "lertaro"
        ]
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.8.2/Lertaro-Portable.zip",
            "hash": "42e81a69be881789b0b25ca48179826108ffd94d082f5845b43fe88b0da37d36",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.8.2/Lertaro-Portable-arm64.zip",
            "hash": "f6ea34186ca5e67921b3b52ef2bf1a93b1b48452440aec80bb197113caa24cde",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        }
    },
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable-arm64.zip"
            }
        }
    }
}
