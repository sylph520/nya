{
    "version": "5.9.8",
    "description": "Portable global search and productivity launcher for Windows",
    "homepage": "https://github.com/Lertaro/Lertaro",
    "license": "MIT",
    "depends": "windowsdesktop-runtime",
    "extract_dir": "Lertaro",
    "persist": "Data",
    "pre_install": [
        "$launcher = @'
@echo off
setlocal
set \"DOTNET_ROOT=%ProgramFiles%\\dotnet\"
cd /d \"%~dp0\"
start \"\" \"Lertaro.App.exe\" %*
'@",
        "Set-Content -LiteralPath \"$dir\\lertaro.cmd\" -Value $launcher -Encoding Ascii"
    ],
    "shortcuts": [
        [
            "lertaro.cmd",
            "lertaro"
        ]
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.9.8/Lertaro-Portable.zip",
            "hash": "a508e0f837454f09a23297575348875f00c2c26055ff28068588b03ccb61716d",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.9.8/Lertaro-Portable-arm64.zip",
            "hash": "25cd51a387faa76ab6062be75656750713ef5fdf6c0eeeecdb64ffb5a7c9d7aa",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        }
    },
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable-arm64.zip"
            }
        }
    }
}
