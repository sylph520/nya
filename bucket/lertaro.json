{
    "version": "5.9.2",
    "description": "Portable global search and productivity launcher for Windows",
    "homepage": "https://github.com/Lertaro/Lertaro",
    "license": "MIT",
    "depends": "windowsdesktop-runtime",
    "extract_dir": "Lertaro",
    "persist": "Data",
    "pre_install": [
        "$launcher = @'
@echo off
setlocal
set \"DOTNET_ROOT=%ProgramFiles%\\dotnet\"
cd /d \"%~dp0\"
start \"\" \"Lertaro.App.exe\" %*
'@",
        "Set-Content -LiteralPath \"$dir\\lertaro.cmd\" -Value $launcher -Encoding Ascii"
    ],
    "shortcuts": [
        [
            "lertaro.cmd",
            "lertaro"
        ]
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.9.2/Lertaro-Portable.zip",
            "hash": "6c3d9675abd37a6a4c54fda67ef5b68746785e48b5779ebb9a13d87c67fde6df",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.9.2/Lertaro-Portable-arm64.zip",
            "hash": "776bea6ca9ad50bb9a8cf89b73746a8c76831028d85e384f6e28a3b1daa9db48",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        }
    },
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable-arm64.zip"
            }
        }
