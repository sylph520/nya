{
    "version": "5.13.3",
    "description": "Portable global search and productivity launcher for Windows",
    "homepage": "https://github.com/Lertaro/Lertaro",
    "license": "MIT",
    "depends": "windowsdesktop-runtime",
    "extract_dir": "Lertaro",
    "persist": "Data",
    "pre_install": [
        "$launcher = @'
@echo off
setlocal
set \"DOTNET_ROOT=%ProgramFiles%\\dotnet\"
cd /d \"%~dp0\"
start \"\" \"Lertaro.App.exe\" %*
'@",
        "Set-Content -LiteralPath \"$dir\\lertaro.cmd\" -Value $launcher -Encoding Ascii"
    ],
    "shortcuts": [
        [
            "lertaro.cmd",
            "lertaro"
        ]
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.13.3/Lertaro-Portable.zip",
            "hash": "db5ea7558e6258056d8818655ac01ee65e24b2e4d1edd718eb253930bcb7bd6e",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.13.3/Lertaro-Portable-arm64.zip",
            "hash": "d3a02e4a0119bd72283d4aaac4d9aba116cf4c53ce347c94c080e1ff4206bd40",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        }
    },
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable-arm64.zip"
            }
        }
    }
}
