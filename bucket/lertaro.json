            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.13.5/Lertaro-Portable-arm64.zip",
            "hash": "d83bc67a93990f234061bab574ccd671e983b8ad490e2a0a158b66f6ae47d9a0",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        }
    },
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
