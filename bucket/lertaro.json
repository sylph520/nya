                    "lertaro"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.12.2/Lertaro-Portable-arm64.zip",
            "hash": "5eec7f4025d5dc59b9b4a1ed96ac840fd060fb58aaabcbde6fb47a17d94a1cdc",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        }
    },
    "checkver": {
