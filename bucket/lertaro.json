{
    "version": "5.14.0",
    "description": "Portable global search and productivity launcher for Windows",
    "homepage": "https://github.com/Lertaro/Lertaro",
    "license": "MIT",
    "depends": "windowsdesktop-runtime",
    "extract_dir": "Lertaro",
    "persist": "Data",
    "pre_install": [
        "$launcher = @'
@echo off
setlocal
set \"DOTNET_ROOT=%ProgramFiles%\\dotnet\"
cd /d \"%~dp0\"
start \"\" \"Lertaro.App.exe\" %*
'@",
        "Set-Content -LiteralPath \"$dir\\lertaro.cmd\" -Value $launcher -Encoding Ascii"
    ],
    "shortcuts": [
        [
            "lertaro.cmd",
            "lertaro"
        ]
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.14.0/Lertaro-Portable.zip",
            "hash": "2c4ba67b3dfdfb7a32d389838a70b48e07a438238acb7885148bc3d0ca90f10e",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.14.0/Lertaro-Portable-arm64.zip",
            "hash": "4ba0f8d230d3736b6908afec4f4df979b639180810d2d10f51b8c1bb4d4ec972",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        }
    },
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable-arm64.zip"
            }
        }
    }
