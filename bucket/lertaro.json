            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.12.10/Lertaro-Portable-arm64.zip",
            "hash": "8d1a25272a4a077d64b5a6c92d316169bd9c5db2574863c7d0b8f7959b37484f",
            "bin": [
                [
                    "lertaro.cmd",
                    "lertaro"
                ]
            ]
        }
    },
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
